# Browser-safe
VITE_DATA_MODE=demo
VITE_SITE_URL=http://localhost:5173
VITE_EVENT_SHARE_TOKEN=replace-with-event-share-token
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only — never prefix these with VITE_
SITE_URL=https://your-event-photo-domain.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
PROMPTPAY_ID=
PROMPTPAY_ACCOUNT_NAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional — automatic slip verification via SlipOK (https://slipok.com)
# Without these, slip uploads always fall back to manual admin review as before.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Optional — get pinged on Telegram the moment a customer submits a slip.
# Without these, nothing changes; you just keep checking the admin dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron — random string at least 16 characters
CRON_SECRET=
